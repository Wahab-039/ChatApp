APP_ENV=development
PORT=8080

# Database (use 'postgres' for Docker service name, 'localhost' for local dev)
DB_HOST=postgres
DB_PORT=5432
DB_USER=chatapp
DB_PASSWORD=change-me-secure-password
DB_NAME=chatapp
DB_SSLMODE=disable

# JWT
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
JWT_ACCESS_TTL=24h

# EMQX (use 'emqx' for Docker service name, 'localhost' for local dev)
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-me-dashboard-password
EMQX_API_URL=http://localhost:18083
EMQX_WS_URL=ws://localhost:8083/mqtt
EMQX_MQTT_TCP_URL=tcp://emqx:1883
EMQX_SERVICE_USERNAME=chatapp_service
EMQX_SERVICE_PASSWORD=replace-with-a-long-random-service-password
EMQX_CLIENT_ID=chatapp-api-1
EMQX_CONNECT_TIMEOUT=10s

